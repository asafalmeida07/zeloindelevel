rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function teamData(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }
    function isTeamAdmin(teamId) {
      return signedIn() && teamData(teamId).adminUid == request.auth.uid;
    }
    function isMaster() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/app)
        && request.auth.uid in get(/databases/$(database)/documents/config/app).data.masterUids;
    }

    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    match /teams/{teamId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.adminUid == request.auth.uid;
      allow update: if signedIn();
      allow delete: if isTeamAdmin(teamId) || isMaster();
    }

    match /progress/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /ranking/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /feed/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn();
    }

    match /champions/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /phases/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}
